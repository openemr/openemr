 #}
<form id="referral_reply_form" method="post" action="confirm_referral_reply.php" onsubmit="return top.restoreSession()">
    <input type="hidden" name="csrf_token_form" value="{{ csrf_token|attr }}" />
    <input type="hidden" name="transid" value="{{ transaction_id|attr }}" />
    <input type="hidden" name="task" value="{{ task_uuid|attr }}" />
</form>
