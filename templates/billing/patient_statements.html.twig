{% extends "core/base.html.twig" %}

{% block head %}
    {{ setupHeader(['datetime-picker', 'datetime-picker-translated']) }}
    <style>
        #invoice-list th[aria-sort="ascending"] button::after {
            content: " \25B2";
        }

        #invoice-list th[aria-sort="descending"] button::after {
            content: " \25BC";
        }
    </style>
{% endblock %}

{% block content %}
<form id="statement-form" method="post" action="patient_statements.php" onsubmit="return top.restoreSession()">
    <input type="hidden" name="csrf_token_form" value="{{ csrfToken|attr }}" />
    <input type="hidden" name="{{ runIdField|attr }}" value="{{ runId|attr }}" />
    <fieldset class="px-2">
        <legend>{{ "Find Invoices"|xlt }}</legend>
        <div class="form-row">
            <div class="form-group col-lg">
                <label class="control-label" for="form_category">{{ "Type"|xlt }}:</label>
                <select name="form_category" id="form_category" class="form-control">
                    {% for category in categories %}
                        <option value="{{ category.value|attr }}"{% if category.value == filters.category %} selected{% endif %}>{{ category.label|text }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group col-lg">
                <label class="control-label" for="form_name">{{ "Name"|xlt }}:</label>
                <input type="text" name="form_name" id="form_name" class="form-control" value="{{ filters.name|attr }}"
                       title="{{ 'Any part of the patient name, or "last,first", or "X-Y"'|xla }}" placeholder="{{ 'Last name, First name'|xla }}" />
            </div>
            <div class="form-group col-lg">
                <label class="control-label" for="form_pid">{{ "Chart ID"|xlt }}:</label>
                <input type="text" name="form_pid" id="form_pid" class="form-control" value="{{ filters.pid|attr }}" title="{{ 'Patient chart ID'|xla }}" />
            </div>
            <div class="form-group col-lg">
                <label class="control-label" for="form_encounter">{{ "Encounter"|xlt }}:</label>
                <input type="text" name="form_encounter" id="form_encounter" class="form-control" value="{{ filters.encounter|attr }}" title="{{ 'Encounter number'|xla }}" />
            </div>
            <div class="form-group col-lg">
                <label class="control-label" for="form_date">{{ "Service Date From"|xlt }}:</label>
                <input type="text" name="form_date" id="form_date" class="form-control datepicker" value="{{ filters.serviceFrom|attr }}"
                       title="{{ 'List invoices with a service date on or after this date'|xla }}" />
            </div>
            <div class="form-group col-lg">
                <label class="control-label" for="form_to_date">{{ "Service Date To"|xlt }}:</label>
                <input type="text" name="form_to_date" id="form_to_date" class="form-control datepicker" value="{{ filters.serviceTo|attr }}"
                       title="{{ 'List invoices with a service date on or before this date'|xla }}" />
            </div>
            <div class="form-group col-lg">
                <label class="control-label" for="form_last_stmt_before">{{ "Last Statement Before"|xlt }}:</label>
                <input type="text" name="form_last_stmt_before" id="form_last_stmt_before" class="form-control datepicker" value="{{ filters.lastStatementBefore|attr }}"
                       title="{{ 'List only invoices last sent a statement before this date, or never sent one'|xla }}" />
            </div>
            <div class="form-group col-lg">
                <label class="control-label" for="form_show_nothing_due"
                       title="{{ 'Due Pt: also list patients whose credits on other visits cover what they owe (no statement goes out for them)'|xla }}">{{ "Show Nothing Due"|xlt }}:</label>
                <input type="checkbox" name="form_show_nothing_due" id="form_show_nothing_due" value="1"{% if filters.showNothingDue %} checked{% endif %} />
            </div>
        </div>
        <button type="submit" class="btn btn-primary btn-search" name="form_search" value="1">{{ "Search"|xlt }}</button>
    </fieldset>

    {% if searched %}
    <fieldset class="px-2 mt-3">
        <legend>{{ "Statements"|xlt }}</legend>
        <div class="table-responsive">
            <table id="invoice-list" class="table table-striped table-sm">
                <thead>
                <tr>
                    <th class="dehead" data-sort="number">{{ "Billing Note"|xlt }}</th>
                    <th class="dehead" data-sort="text">{{ "Patient"|xlt }}</th>
                    <th class="dehead" data-sort="text">{{ "Invoice"|xlt }}</th>
                    <th class="dehead" data-sort="date">{{ "Svc Date"|xlt }}</th>
                    <th class="dehead" data-sort="date">{{ "Last Stmt"|xlt }}</th>
                    <th class="dehead text-right" data-sort="number">{{ "Charge"|xlt }}</th>
                    <th class="dehead text-right" data-sort="number">{{ "Adjust"|xlt }}</th>
                    <th class="dehead text-right" data-sort="number">{{ "Paid"|xlt }}</th>
                    <th class="dehead text-right" data-sort="number">{{ "Balance"|xlt }}</th>
                    <th class="dehead text-center" data-sort="number" title="{{ 'Statements sent, or minus the insurance levels still open'|xla }}">{{ "Prv"|xlt }}</th>
                    <th class="dehead text-left">{{ "Sel"|xlt }}</th>
                    <th class="dehead text-center" data-sort="text">{{ "Email"|xlt }}</th>
                </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr>
                        <td class="detail">
                            <a href="#" class="btn btn-secondary btn-sm" onclick="billingNote(event, {{ row.pid|attr_js }})">{{ row.pid|text }}</a>
                        </td>
                        <td class="detail">
                            <a href="#" class="btn btn-secondary btn-sm" onclick="toEncounters(event, {{ row.pid|attr_js }})">{{ row.patient|text }}</a>
                        </td>
                        <td class="detail" data-sort-value="{{ (row.pid ~ ':' ~ row.encounter)|attr }}" data-encounter="{{ row.encounter|attr }}">
                            <a href="#" class="btn btn-secondary btn-sm" onclick="editInvoice(event, {{ row.id|attr_js }})">{{ row.pid|text }}.{{ row.encounter|text }}</a>
                        </td>
                        <td class="detail" data-sort-value="{{ row.serviceDate|attr }}">{{ row.serviceDate|shortDate|text }}</td>
                        <td class="detail" data-sort-value="{{ row.lastStatementDate|attr }}">{{ row.lastStatementDate|shortDate|text }}</td>
                        <td class="detail text-right" data-sort-value="{{ row.chargesSort|attr }}">{{ row.charges|text }}</td>
                        <td class="detail text-right" data-sort-value="{{ row.adjustmentsSort|attr }}">{{ row.adjustments|text }}</td>
                        <td class="detail text-right" data-sort-value="{{ row.paidSort|attr }}">{{ row.paid|text }}</td>
                        <td class="detail text-right" data-sort-value="{{ row.balanceSort|attr }}">{{ row.balance|text }}</td>
                        <td class="detail text-center" data-sort-value="{{ row.dunCount|attr }}">{% if row.dunCount != 0 %}{{ row.dunCount|text }}{% endif %}</td>
                        <td class="detail text-left">
                            <input type="checkbox" name="form_cb[{{ row.id|attr }}]" aria-label="{{ 'Select'|xla }} {{ row.pid|attr }}.{{ row.encounter|attr }}"{% if row.checked %} checked{% endif %} />
                            {% if row.inCollections %}<span class="font-weight-bold text-danger" title="{{ 'In collections'|xla }}">IC</span>{% endif %}
                            {% if row.netDue is not null %}
                                <span class="badge badge-info" title="{{ 'Credits on other visits cover what is owed; no statement goes out'|xla }}">{{ "credit"|xlt }} {{ row.netDue|text }}</span>
                            {% endif %}
                            {% if row.portal %}<span title="{{ 'Patient portal user'|xla }}">PPt</span>{% endif %}
                        </td>
                        <td class="detail text-left">{% if row.emailable %}{{ "YES"|xlt }}{% else %}{{ "NO"|xlt }}{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="12" class="text-muted">{{ "No invoices found."|xlt }}</td></tr>
                {% endfor %}
                {% if hiddenPatients > 0 %}
                    <tr id="nothing-due-hidden">
                        <td colspan="12" class="text-muted">
                            {{ "Hidden, nothing due after credits"|xlt }}: {{ hiddenPatients|text }} {{ "patient(s). Their credits on other visits cover what they owe, so no statement goes out. Tick Show Nothing Due to list them."|xlt }}
                        </td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>
        {% if rows is not empty %}
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-secondary btn-save" onclick="checkAll(true)">{{ "Select All"|xlt }}</button>
            <button type="button" class="btn btn-secondary btn-undo" onclick="checkAll(false)">{{ "Clear All"|xlt }}</button>
            {% if textStatements %}
                <button type="submit" class="btn btn-secondary btn-print" name="form_print" value="1">{{ "Print Selected"|xlt }}</button>
                <button type="submit" class="btn btn-secondary btn-download" name="form_download" value="1">{{ "Download Selected"|xlt }}</button>
            {% endif %}
            <button type="submit" class="btn btn-secondary btn-download" name="form_pdf" value="1">{{ "PDF Download Selected"|xlt }}</button>
            <button type="submit" class="btn btn-secondary btn-mail" name="form_email" value="1">{{ "Email Selected"|xlt }}</button>
            {% if anyPortal %}
                <button type="submit" class="btn btn-secondary btn-save" name="form_portalnotify" value="1">{{ "Notify Patients Portal"|xlt }}</button>
            {% endif %}
            <label class="radio-inline btn">{{ "Without Update"|xlt }}
                <input type="checkbox" name="form_without" value="1" />
            </label>
        </div>
        {% endif %}
    </fieldset>
    {% endif %}
</form>
{% endblock %}

{% block scripts %}
<script>
    function checkAll(checked) {
        document.querySelectorAll('#invoice-list input[name^="form_cb["]').forEach(function (box) {
            box.checked = checked;
        });
    }

    function editInvoice(e, id) {
        e.preventDefault();
        const params = new URLSearchParams({id: id, isPosting: '1'});
        dlgopen('sl_eob_invoice.php?' + params, 'editInvoiceDlg', 'modal-full', false, false, '', {sizeHeight: 'full'});
    }

    function billingNote(e, pid) {
        e.preventDefault();
        dlgopen('sl_eob_patient_note.php?patient_id=' + encodeURIComponent(pid), 'billnote', 'modal-sm', 275, '');
    }

    function toEncounters(e, pid) {
        e.preventDefault();
        top.restoreSession();
        parent.left_nav.loadFrame('pat2', 'pat', 'patient_file/summary/demographics.php?set_pid=' + encodeURIComponent(pid));
        // The patient has to load before their encounters can open in the billing view.
        setTimeout(function () {
            parent.left_nav.loadFrame('enc2', 'enc', 'patient_file/history/encounters.php?billing=1&issue=0&pagesize=20&pagestart=0');
        }, 3000);
    }

    $(function () {
        datetimepickerTranslated('.datepicker', {timepicker: false, formatInput: false});
        {% if message is not empty %}
        alert({{ message|js_escape }});
        {% endif %}
    });
</script>
<script src="{{ webroot|attr }}/interface/billing/sl_eob_search_sort.js?v={{ assetVersion|attr_url }}"></script>
{% endblock %}
