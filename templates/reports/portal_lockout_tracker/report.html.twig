<html>

<head>
    <title>{{ 'Portal Lockout Tracker'|xlt }}</title>

    {{ setupHeader(['report-helper']) }}

    <script>
        $(function () {
            var win = top.printLogSetup ? top : opener.top;
            win.printLogSetup(document.getElementById('printbutton'));
        });

        function resetPortalCounter(portalLoginUsername) {
            top.restoreSession();
            request = new FormData;
            request.append("function", "resetPortalAccountCounter");
            request.append("portalLoginUsername", portalLoginUsername);
            request.append("csrf_token_form", {{ counterCsrfToken|js_escape }});
            fetch({{ ajaxUrl|js_escape }}, {
                method: 'POST',
                credentials: 'same-origin',
                body: request
            }).then(function (response) {
                // Only paint "cleared" once the server confirmed success.
                // The handler returns 403 on ACL denial and the browser
                // reports network failures via response.ok=false too, so
                // this keeps the row honest for both cases; getElementById
                // takes a raw id, not a CSS selector, so the raw
                // portal_login_username is concatenated as-is (CSS.escape()
                // would add backslashes before dots/@ and break lookups
                // for the common case of an email-address portal username).
                if (!response.ok) {
                    return;
                }
                let counterEl = document.getElementById('portal-fail-counter-' + portalLoginUsername);
                if (counterEl) {
                    counterEl.innerHTML = "0";
                }
                let lastFailEl = document.getElementById('portal-last-fail-' + portalLoginUsername);
                if (lastFailEl) {
                    lastFailEl.innerHTML = jsXlt("Not Applicable");
                }
                let autoBlockEl = document.getElementById('portal-autoblock-' + portalLoginUsername);
                if (autoBlockEl) {
                    autoBlockEl.innerHTML = jsXlt("No");
                }
            });
        }

    </script>

    <style>
        /* specifically include & exclude from printing */
        @media print {
            #report_parameters {
                visibility: hidden;
                display: none;
            }
            #report_results table {
                margin-top: 0px;
            }
        }
    </style>
</head>

<body class="body_top">

<span class='title'>{{ 'Portal Lockout Tracker'|xlt }}</span>

<form method='post' name='theform' id='theform' action='portal_lockout_tracker.php' onsubmit='return top.restoreSession()'>
    <input type="hidden" name="csrf_token_form" value="{{ formCsrfToken|attr }}" />

    <div id="report_parameters">
        <table>
            <tr>
                <td width='650px'>
                    <div style='float: left'>
                        <table class='text'>
                            <tr>
                                <td>
                                    <div class="checkbox">
                                        <label>
                                            <input type='checkbox' id='showOnlyAutoBlocked' name='showOnlyAutoBlocked'{% if showOnlyAutoBlocked %} checked{% endif %}> {{ 'Show Only Auto Blocked'|xlt }}
                                        </label>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
                <td class='h-100' align='left' valign='middle'>
                    <table class='w-100 h-100' style='border-left: 1px solid;'>
                        <tr>
                            <td>
                                <div class="text-center">
                                    <div class="btn-group" role="group">
                                        <a href='#' class='btn btn-secondary btn-save' onclick='$("#form_refresh").attr("value","true"); $("#theform").submit();'>
                                            {{ 'Submit'|xlt }}
                                        </a>
                                        {% if formRefresh %}
                                            <a href='#' class='btn btn-secondary btn-print' id='printbutton'>
                                                {{ 'Print'|xlt }}
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
    <!-- end of search parameters -->
    {% if formRefresh %}
        <div id="report_results">
            <table class='table'>
                <thead class='thead-light'>
                    <th>{{ 'Portal Login Username'|xlt }}</th>
                    <th>{{ 'Patient ID'|xlt }}</th>
                    <th>{{ 'Failed Login Counter'|xlt }}</th>
                    <th>{{ 'Last Failed Login'|xlt }}</th>
                    <th>{{ 'Auto Blocked'|xlt }}</th>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr valign='top'>
                            <td class="detail">{{ row.portal_login_username|text }}</td>
                            <td class="detail">{{ row.pid|text }}</td>
                            <td class="detail" id="portal-fail-counter-{{ row.portal_login_username|attr }}">
                                {{ row.portal_fail_counter|text }}
                                {% if row.portal_fail_counter > 0 %}
                                    <button type="button" class="btn btn-sm btn-danger ml-2" onclick="resetPortalCounter({{ row.portal_login_username|attr_js }})">{{ 'Reset Counter'|xlt }}</button>
                                {% endif %}
                            </td>
                            <td class="detail" id="portal-last-fail-{{ row.portal_login_username|attr }}">{% if row.portal_last_fail is not null %}{{ row.portal_last_fail|oeFormatDateTime|text }}{% else %}{{ 'Not Applicable'|xlt }}{% endif %}</td>
                            <td class="detail" id="portal-autoblock-{{ row.portal_login_username|attr }}">
                                {% if row.autoBlocked %}
                                    {{ 'Yes'|xlt }}
                                    {% if row.autoBlockEnd is not null %}
                                        ({{ 'Autoblock ends on'|xlt }} {{ row.autoBlockEnd|oeFormatDateTime|text }})
                                    {% endif %}
                                {% else %}
                                    {{ 'No'|xlt }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <!-- end of search results -->
    {% else %}
        <div class='text'>{{ 'Please click Submit to view results.'|xlt }}</div>
    {% endif %}
    <input type='hidden' name='form_refresh' id='form_refresh' value='' />
</form>

</body>

</html>
