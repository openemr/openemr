{# Style rules for Visit List blocks in the print views, included inside each print
   template's <style> element. The print views load no theme, so these are plain colors.

   @package   OpenEMR
   @link      https://www.open-emr.org
   @author    David Eschelbacher <psoas@tampabay.rr.com>
   @copyright Copyright (c) 2026 David Eschelbacher <psoas@tampabay.rr.com>
   @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
#}
.event_visit_list { background-color: #fff; border: 1px solid #000; font-size: 0.8em; }
.visit-list-header { border-bottom: 1px solid #999; padding: 0 2px; }
.visit-list-title { font-weight: bold; }
.visit-list-entries { list-style: none; margin: 0; padding: 0 2px; }
.visit-list-entry { white-space: nowrap; }
.visit-list-sequence { display: inline-block; font-weight: bold; min-width: 1.75em; }
.visit-list-category { font-style: italic; }
