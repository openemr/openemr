{# Shared JS for the three on-screen calendar templates (day, week, month).
   Pulled from the legacy template's inline [-php-] echo blocks. Defines
   newEvt / oldEvt / oldGroupEvt for the appointment dialogs,
   providerXclick for the provider-column close button, plus the
   document.ready jQuery handler that wires UI clicks to these.

   The legacy code embedded webroot + Date into ChangeDate and PrintView
   URLs at render time; preserved here via Twig substitution. #}
<script>
    function event_time_click(elem) {
        EditEvent($(elem).parents("div.event_appointment").get(0));
    }
</script>
<script>

 // This is called from the event editor popup.
 function refreshme() {
  top.restoreSession();
  document.forms[0].submit();
 }

 function newEvt(startampm, starttimeh, starttimem, eventdate, providerid, catid) {
  dlgopen('add_edit_event.php?startampm=' + encodeURIComponent(startampm) +
   '&starttimeh=' + encodeURIComponent(starttimeh) + '&userid=' + encodeURIComponent(providerid) + '&starttimem=' + encodeURIComponent(starttimem) +
   '&date=' + encodeURIComponent(eventdate) + '&catid=' + encodeURIComponent(catid)
   ,'_blank', 780, 675, '', '', {onClosed: 'refreshme'});
 }

 function oldEvt(eventdate, eventid, pccattype) {
  dlgopen('add_edit_event.php?date=' + encodeURIComponent(eventdate) + '&eid=' + encodeURIComponent(eventid) + '&prov=' + encodeURIComponent(pccattype), '_blank', 780, 650);
 }

 function oldGroupEvt(eventdate, eventid, pccattype){
  top.restoreSession();
  dlgopen('add_edit_event.php?group=true&date=' + encodeURIComponent(eventdate) + '&eid=' + encodeURIComponent(eventid) + '&prov=' + encodeURIComponent(pccattype), '_blank', 780, 675);
 }

 function goPid(pid) {
  top.restoreSession();
  top.RTop.location = '../../patient_file/summary/demographics.php' + '?set_pid=' + encodeURIComponent(pid);
 }

 function goGid(gid) {
  top.restoreSession();
  top.RTop.location = '{{ webroot }}/therapy_groups/index.php' + '?method=groupDetails&group_id=' + encodeURIComponent(gid);
 }

 function GoToToday(theForm){
  var todays_date = new Date();
  var theMonth = todays_date.getMonth() + 1;
  theMonth = theMonth < 10 ? "0" + theMonth : theMonth;
  theForm.jumpdate.value = todays_date.getFullYear() + "-" + theMonth + "-" + todays_date.getDate();
  top.restoreSession();
  theForm.submit();
 }

 function ShowImage(src) {
     var img = document.getElementById('popupImage');
     var div = document.getElementById('popup');
     img.src = src;
     div.style.display = "block";
 }

 function HideImage() {
     document.getElementById('popup').style.display = "none";
 }
</script>
<script>
    {# Server-supplied values are extracted to JS vars here so each is
       single-escaped for the JS-string context via |js_escape (text)
       or left bare for type-narrowed ints (timeslotHeightVal is
       int-typed in CalendarRenderDataBuilder). Subsequent URL
       construction uses string concatenation + encodeURIComponent so
       each value is escaped exactly once for its sink. #}
    var tsHeight={{ timeslotCss|default('20px')|js_escape }};
    var tsHeightNum={{ timeslotHeightVal|default(20) }};
    {# Original server-rendered slot height. Event geometry is emitted in
       these base pixels; fitCalendarToViewport() scales from this so
       resize/re-fit never compounds. #}
    var tsHeightBase = tsHeightNum;
    var pcWebroot={{ webroot|js_escape }};
    var pcViewtype={{ viewtype|default('day')|js_escape }};
    var pcDate={{ Date|default('')|js_escape }};

    function providerXclick(e) {
        var username=$(this).data('username');
        if (username=='__PC_ALL__') {
            $("#pc_username option:gt(0)").prop("selected", true);
        } else {
            $("#pc_username option[value="+username+"]").prop("selected", false);
        }
        ChangeProviders($("#pc_username"));
    }

    $(function () {
        $("#pc_username").change(function() { ChangeProviders(this); });
        $("#pc_facility").change(function() { ChangeProviders(this); });
        $("#dayview").click(function() { ChangeView(this); });
        $("#weekview").click(function() { ChangeView(this); });
        $("#monthview").click(function() { ChangeView(this); });
        $(".tdDatePicker").click(function() { ChangeDate(this); });
        $("#datePicker .tdDatePicker").mouseover(function() {
          $(this).toggleClass("tdDatePickerHighlightCurrent");
        });
        $("#datePicker .tdDatePicker").mouseout(function() {
          $(this).toggleClass("tdDatePickerHighlightCurrent");
        });
        $("#printview").click(function() { PrintView(this); });
        $(".event").dblclick(function() { EditEvent(this); });
        $(".event").mouseover(function() { $(this).toggleClass("event_highlight"); });
        $(".event").mouseout(function() { $(this).toggleClass("event_highlight"); });
        $(".tdMonthName-small").click(function() {
            dpCal = $("#datePicker > table");
            mp = $("#monthPicker");
            mp.width(dpCal.width());
            mp.toggle();
        });

        $('.providerXbtn').on('click', providerXclick);
    });

    /* edit an existing event */
    var EditEvent = function(eObj) {
        objID = eObj.id;
        var parts = new Array();
        parts = objID.split("-");
        editing_group = $(eObj).hasClass("groups");
        if(editing_group){
            oldGroupEvt(parts[0], parts[1], parts[2]);
            return true;
        }
        oldEvt(parts[0], parts[1], parts[2]);
        return true;
    }

    var ChangeDate = function(eObj) {
        baseURL = pcWebroot + "/interface/main/calendar/index.php?module=PostCalendar&func=view&viewtype=" + encodeURIComponent(pcViewtype) + "&Date=~REPLACEME~&pc_username=&pc_category=&pc_topic=";
        newURL = baseURL.replace(/~REPLACEME~/, eObj.id);
        document.location.href=newURL;
    }

    var PrintView = function (eventObject) {
        printURL = pcWebroot + "/interface/main/calendar/index.php?module=PostCalendar&func=view&viewtype=" + encodeURIComponent(pcViewtype) + "&Date=" + encodeURIComponent(pcDate) + "&print=1&pc_username=&pc_category=&pc_topic=";
        window.open(printURL,'printwindow','width=740,height=480,toolbar=no,location=no,directories=no,status=no,menubar=yes,scrollbars=yes,copyhistory=no,resizable=yes');
        return false;
    }

    var ChangeProviders = function (eventObject) {
        $('#theform').submit();
    };

    var ChangeView = function (eventObject) {
        if (eventObject.id == "dayview") { $("#viewtype").val('day'); }
        else if (eventObject.id == "weekview") { $("#viewtype").val('week'); }
        else if (eventObject.id == "monthview") { $("#viewtype").val('month'); }
        else if (eventObject.id == "yearview") { $("#viewtype").val('year'); }
        $('#theform').submit();
    };

    $("#menu-toggle").click(function(e) {
        e.preventDefault();
        $("#wrapper").toggleClass("toggled");
        // Sidebar width animates; re-fit after the transition settles.
        window.setTimeout(fitCalendarToViewport, 280);
    });

    /**
     * Stretch day/week timeslots (and absolutely-positioned events) so the
     * schedule uses the visible frame instead of leaving empty page below
     * a fixed 20px grid. Geometry stays aligned because every event's top
     * and height are scaled from the original server pixel values.
     */
    function fitCalendarToViewport() {
        if (pcViewtype !== 'day' && pcViewtype !== 'week') {
            return;
        }

        var $times = $('#bigCal').find('#times').first();
        var $slotCells = $('#bigCal').find('#times td.timeslot');
        if (!$slotCells.length || !$times.length) {
            return;
        }

        // One grid's row count (day = one times column; week repeats the
        // same count per provider — use the first column as the measure).
        var slotCount = $times.find('td.timeslot').length;
        if (!slotCount || !tsHeightBase) {
            return;
        }

        // Capture original px geometry once (from the PHP-rendered styles).
        $('#bigCal .calendar_day .event').each(function () {
            if (this.hasAttribute('data-base-top')) {
                return;
            }
            this.setAttribute('data-base-top', String(parseFloat(this.style.top) || 0));
            this.setAttribute('data-base-height', String(parseFloat(this.style.height) || 0));
        });

        var toolbar = document.getElementById('topToolbarRight');
        var topOffset = toolbar ? toolbar.getBoundingClientRect().bottom : 0;
        // Prefer the calendar frame height when embedded in OpenEMR tabs.
        var frameHeight = window.innerHeight;
        try {
            if (window.frameElement && window.frameElement.clientHeight) {
                frameHeight = window.frameElement.clientHeight;
            }
        } catch (ignore) {
            // Cross-origin frame access is not expected in OpenEMR.
        }
        // Small bottom pad so the last slot isn't flush against the frame.
        var available = Math.floor(frameHeight - topOffset - 10);
        var minH = tsHeightBase;
        // Cap so a short clinic day on a tall monitor doesn't create huge rows.
        var maxH = 48;
        var fitted = Math.floor(available / slotCount);
        var newH = Math.max(minH, Math.min(maxH, fitted));
        var scale = newH / tsHeightBase;

        $slotCells.css('height', newH + 'px');
        // Day-view provider name row sits beside the first timeslot spacer.
        $('#bigCal .providerheader.providerday').css({
            height: newH + 'px',
            lineHeight: newH + 'px',
            boxSizing: 'border-box'
        });

        $('#bigCal .calendar_day .event').each(function () {
            var baseTop = parseFloat(this.getAttribute('data-base-top')) || 0;
            var baseHeight = parseFloat(this.getAttribute('data-base-height')) || 0;
            this.style.top = (baseTop * scale) + 'px';
            this.style.height = (baseHeight * scale) + 'px';
        });

        // Keep click-to-create marker math in sync with the live row height.
        tsHeightNum = newH;
        tsHeight = newH + 'px';
    }

    $(function () {
        fitCalendarToViewport();
        // Second pass after layout/fonts settle inside the tab iframe.
        window.setTimeout(fitCalendarToViewport, 50);
        $(window).on('resize.calendarFit', fitCalendarToViewport);
    });
</script>

{# Day/week layout that does not depend on a theme rebuild:
   - vertical fit (above)
   - horizontal scroll with readable provider columns
   - sticky time column so providers scroll underneath it
   - IN/OUT under appointments + provider header #}
<style>
    /* Scroll container: providers overflow to the right; times stay pinned. */
    #bigCal {
        overflow-x: auto !important;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        width: 100%;
    }
    #bigCal > .table-responsive {
        overflow: visible !important;
    }
    #bigCal > .table-responsive > table.table {
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 0;
        min-width: 100%;
        table-layout: auto;
        width: max-content;
    }

    /* Sticky time gutter — schedule columns slide under this while scrolling. */
    #bigCal td#times {
        background-color: var(--white, #fff);
        border-right: 1px solid var(--gray300, #dee2e6);
        box-shadow: 2px 0 4px rgba(0, 0, 0, 0.08);
        left: 0;
        padding: 0.3125rem !important;
        position: sticky;
        vertical-align: top;
        width: 3.25rem;
        min-width: 3.25rem;
        max-width: 3.5rem;
        z-index: 8;
    }
    #bigCal td#times .table-responsive {
        overflow: visible !important;
    }
    #bigCal td#times table {
        width: 100%;
    }
    #bigCal td.timeslot {
        box-sizing: border-box;
        white-space: nowrap;
    }

    /* Each provider keeps a readable min width; more columns => horizontal scroll. */
    #bigCal td.schedule {
        min-width: 11.5rem;
        padding: 0 !important;
        position: relative;
        vertical-align: top;
        width: 11.5rem;
    }

    /* Header: name truncates, close (X) always visible. */
    #bigCal .providerheader {
        align-items: center;
        box-sizing: border-box;
        display: flex;
        gap: 0.25rem;
        justify-content: space-between;
        overflow: hidden;
        padding: 0 0.35rem;
        position: relative;
        white-space: nowrap;
        z-index: 5;
    }
    #bigCal .providerheader .provider-name {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-align: center;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    #bigCal .providerheader .providerXbtn {
        flex: 0 0 auto;
        float: none;
        line-height: 1;
        margin: 0;
        opacity: 0.9;
        padding: 0 0.15rem;
    }

    #bigCal .calendar_day .event_in {
        pointer-events: none;
        z-index: 1;
    }
    #bigCal .calendar_day .event_out {
        z-index: 1;
    }
    #bigCal .calendar_day .in_start {
        pointer-events: auto;
        z-index: 1;
    }
    #bigCal .calendar_day .event_appointment,
    #bigCal .calendar_day .event_reserved,
    #bigCal .calendar_day .event_noshow,
    #bigCal .calendar_day .event_holiday {
        box-sizing: border-box;
        line-height: 1.15;
        overflow: hidden;
        padding: 0 0.25rem;
        white-space: normal;
        z-index: 3;
    }
    #bigCal .calendar_day .event_out.event_highlight,
    #bigCal .calendar_day .in_start.event_highlight {
        z-index: 4;
    }
</style>
