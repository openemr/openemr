{# The Transactions screen's Transaction Type: one option per LBT layout. #}
<select name='title' id='title' class='form-control' onchange='titleChanged()'>
{% for type in types %}
<option value='{{ type.grp_form_id|attr }}'{{ type.grp_form_id == selected ? ' selected' }}>{{ type.grp_title|text }}</option>
{% endfor %}
</select>
