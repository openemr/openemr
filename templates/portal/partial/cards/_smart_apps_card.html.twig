<!-- Health Apps Card -->
<div class="card collapse overflow-auto" data-parent="#cardgroup" id="{{ id|attr }}">
    <header class="card-header p-1 bg-dark text-light h3">{{ 'Health Apps' | xlt }}</header>
    <div class="card-body">
        <p class="text-muted">{{ 'These apps work with your health record. An app opens in a new window and asks you to sign in and allow it access.' | xlt }}</p>
        <ul class="list-group">
            {% for app in apps %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>{{ app.name | text }}</span>
                    <a class="btn btn-success btn-sm" href="{{ app.url | attr }}" target="_blank" rel="noopener noreferrer">{{ 'Launch' | xlt }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
