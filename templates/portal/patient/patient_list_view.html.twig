{#
 # The patient profile page (portal/patient/patientdata): the profile form a portal patient edits
 # and staff review, and the self-registration form (`register`).
 #
 # Variables:
 # - register, recid, cpid, cuser: page state, also handed to patientdata.js as JS globals;
 #   patientdata.js fills the form copied from #patientModelTemplate from the profile API;
 # - trow: the profile row (camelCase keys), for the provider selects;
 # - users_list: the providers a patient may choose (rows of id, fname, lname);
 # - exclude: the element ids of the fields the layout hides from the portal;
 # - select_lists: the list-backed selects, by field (title, sex, status, state, race,
 #   ethnicity, religion), as rendered HTML;
 # - datetimepicker_js: the date picker localisation script;
 # - and the shared portal page context.
 #
 # @package   OpenEMR
 # @link      https://www.open-emr.org
 # @author    Jerry Padgett <sjpadgett@gmail.com>
 # @author    Terry Hill <teryhill@yahoo.com>
 # @copyright Copyright (c) 2016-2026 Jerry Padgett <sjpadgett@gmail.com>
 # @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
 #}
{% set row = trow ?: [] %}
{% include 'portal/patient/_modal_form_header.html.twig' with {title: 'Patient Portal'|xl ~ ' | ' ~ 'Patient Data'|xl} %}
<script>var register={{ register|js_escape }};var recid='{{ recid|attr }}';var webRoot={{ web_root|js_escape }};var cpid='{{ cpid|attr }}';var cuser={{ cuser|js_escape }};</script>

<script src="{{ web_root }}/portal/patient/scripts/app/patientdata.js?v={{ v_js_includes|attr_url }}"></script>
<script>
    $(function () {
        page.init();
    });
    // bring in the datepicker and datetimepicker localization and setting elements
    {{ datetimepicker_js }}

    // profile excludes global from layouts via PatientController
    const exclude = {{ (exclude ?: [])|js_escape }};
</script>
{% if register %}
<style>
    .form-group .inline .dynhide {
        display: none;
    }

    body {
        padding-top: 0;
        padding-bottom: 5px;
        background-color: #fff !important;
    }
</style>
<script>
    // Fixes iFrame in Patient Registratiion
    setInterval(function() {
        window.top.postMessage(document.body.scrollHeight, "*");
    }, 500);
</script>
{% endif %}
