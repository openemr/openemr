 #}
<!DOCTYPE html>
<!-- Language grabbed by PDF var that has the correct format !-->
<html lang="{{ pdf_language|attr }}">
<head>
    <title>{{ ('Portal Dashboard'|xl ~ ' | ' ~ 'Home'|xl)|text }}</title>
    <meta name="description" content="Provider Portal" />
    <meta name="author" content="Dashboard | sjpadgett@gmail.com" />

    {{ setupHeader(['datetime-picker'], false) }}
    <script>var cpid='{{ cpid|attr }}';var cuser='{{ cuser|attr }}';var webRoot={{ web_root|js_escape }};</script>
    <link href="{{ web_root }}/portal/sign/css/signer_modal.css?v={{ v_js_includes }}" rel="stylesheet">
    <script src="{{ web_root }}/portal/sign/assets/signature_pad.umd.js?v={{ v_js_includes }}"></script>
    <script src="{{ web_root }}/portal/sign/assets/signer_api.js?v={{ v_js_includes }}"></script>
</head>

<body class="pt-2">
<div class="modal fade" id="formdialog" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog bg-light">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">{{ 'About Portal Dashboard'|xlt }}</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div>
                    <span>{{ 'Please see forum or wiki'|xlt }}
                <a href="{{ 'https://community.open-emr.org/'|attr }}" target="_blank">{{ 'Visit Forum'|xlt }}</a>
                    </span>
                </div>
            </div>
            <div class="modal-footer">
                <button id="okButton" data-dismiss="modal" class="btn btn-secondary">{{ 'Close...'|xlt }}</button>
            </div>
        </div>
    </div>
</div>
<div class="container p-3">
    <div class="jumbotron jumbotron-fluid text-center p-1">
        <h3>{{ 'Portal Dashboard'|xlt }}<i class="fa fa-user-md text-danger ml-2" style="font-size: 3rem;"></i></h3>
        <p>
        <button class="btn btn-sm btn-secondary" data-toggle="modal" data-target="#formdialog">{{ 'Tell me more'|xlt }}</button>
        </p>
    </div>
<div class='jumbotron jumbotron-fluid p-4'>
    <div class="row">
        <div class="col">
            <h4><i class="icon-cogs"></i>{{ 'Templates'|xlt }}</h4>
            <a class="btn btn-success btn-sm" href="{{ web_root }}/portal/import_template_ui.php">{{ 'Manage Templates'|xlt }}</a>
        </div>
        <div class="col">
            <h4><i class="icon-th"></i>{{ 'Audits'|xlt }}</h4>
            <a class="btn btn-success btn-sm" href="{{ web_root }}/portal/patient/onsiteactivityviews">{{ 'Review Audits'|xlt }}</a>
        </div>
        <div class="col">
            <h4><i class="icon-cogs"></i>{{ 'Mail'|xlt }}</h4>
            <a class="btn btn-success btn-sm" href="{{ web_root }}/portal/messaging/messages.php">{{ 'Secure Mail'|xlt }}</a>
        </div>
        <div class="col">
            <h4><i class="icon-signin"></i>{{ 'Signature'|xlt }}</h4>
            <p><a data-type="admin-signature" class="btn btn-primary btn-sm" href="#openSignModal" data-toggle="modal" data-backdrop="true" data-target="#openSignModal">
             <span>{{ 'Signature on File'|xlt ~ '  ' }}</span><i class="fa fa-sign-in"></i></a></p>
        </div>
    </div>
</div>
</div>
<!-- /container -->

{% include 'portal/patient/_footer.html.twig' %}
