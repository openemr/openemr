{#
 # Patient Portal Documents: the documents and forms page (GET onsitedocuments), for a portal
 # patient, for staff reviewing a patient's documents, and for the document templates module.
 #
 # Variables, from OnsiteDocumentController::ListView():
 # - cpid: the patient's pid; cuser: the session user (`-patient-` for a portal patient);
 #   pt_name: the patient's name, or the pid when the session has none;
 # - is_portal (0|1), is_module, doc_edit, recid, docid, help_id, new_filename, save_catid,
 #   auto_render, audit_render, auto_render_name, referer_flag: the request, as given;
 # - category_name: the name of category save_catid, or null when there is none;
 # - language_defs: the i18next translations; datetimepicker_js: the date picker translations;
 # - form_names_whitelist: the portal-compliant encounter form directories;
 # - template_menu: the Select Form menu HTML (module and portal only);
 # - allow_portal_uploads (bool); portal_home_url, exit_url: the exit links;
 # and the shared portal page context (ROOT_URL, web_root, assets_static_relative, v_js_includes).
 #
 # @package   OpenEMR
 # @link      https://www.open-emr.org
 # @author    Jerry Padgett <sjpadgett@gmail.com>
 # @author    Tyler Wrenn <tyler@tylerwrenn.com>
 # @copyright Copyright (c) 2016-2026 Jerry Padgett <sjpadgett@gmail.com>
 # @copyright Copyright (c) 2020 Tyler Wrenn <tyler@tylerwrenn.com>
 # @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
 #}
