{% set auto_render = auto_render ?? 0 %}
{% set audit_render = audit_render ?? 0 %}
{% set auto_render_name = auto_render_name ?? '' %}
{% set referer_flag = referer_flag ?? 0 %}
{% set csrf_token = csrfTokenRaw() %}
