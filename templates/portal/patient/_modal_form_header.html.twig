{#
 # Page head for the patient profile page: jQuery, the date pickers, the Backbone stack and the
 # API CSRF token. Registration (`register`) adds Bootstrap, which the portal frame supplies
 # otherwise. Pass `title`.
 #
 # @package   OpenEMR
 # @link      https://www.open-emr.org
 # @author    Jerry Padgett <sjpadgett@gmail.com>
 # @author    Tyler Wrenn <tyler@tylerwrenn.com>
 # @copyright Copyright (c) 2016-2026 Jerry Padgett <sjpadgett@gmail.com>
 # @copyright Copyright (c) 2020 Tyler Wrenn <tyler@tylerwrenn.com>
 # @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
 #}
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />

<title>{{ title|attr }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

<meta name="description" content="Patient Profile" />
<meta name="author" content="Form | sjpadgett@gmail.com" />

<script src="{{ assets_static_relative }}/jquery/dist/jquery.min.js?v={{ v_js_includes|attr_url }}"></script>
<link href="{{ assets_static_relative }}/@fortawesome/fontawesome-free/css/all.min.css?v={{ v_js_includes|attr_url }}" rel="stylesheet" />
<link href="{{ assets_static_relative }}/jquery-datetimepicker/build/jquery.datetimepicker.min.css?v={{ v_js_includes|attr_url }}" rel="stylesheet" />
{% if register %}
    <link href="{{ assets_static_relative }}/bootstrap/dist/css/bootstrap.min.css?v={{ v_js_includes|attr_url }}" rel="stylesheet">
    <script src="{{ assets_static_relative }}/bootstrap/dist/js/bootstrap.bundle.min.js?v={{ v_js_includes|attr_url }}"></script>
{% endif %}

<script src="{{ assets_static_relative }}/moment/moment.js?v={{ v_js_includes|attr_url }}"></script>
<script src="{{ assets_static_relative }}/jquery-datetimepicker/build/jquery.datetimepicker.full.min.js?v={{ v_js_includes|attr_url }}"></script>
<script src="{{ assets_static_relative }}/underscore/underscore-min.js?v={{ v_js_includes|attr_url }}"></script>
<script src="{{ assets_static_relative }}/backbone/backbone-min.js?v={{ v_js_includes|attr_url }}"></script>
<script src="{{ web_root }}/portal/patient/scripts/app.js?v={{ v_js_includes }}"></script>
<script>window.portalApiCsrfToken = {{ csrfTokenRaw()|js_escape }};</script>
<script src="{{ web_root }}/portal/patient/scripts/model.js?v={{ v_js_includes }}"></script>
<script src="{{ web_root }}/portal/patient/scripts/view.js?v={{ v_js_includes }}"></script>
<base href="{{ ROOT_URL|attr }}" />
<script src="{{ web_root }}/portal/patient/scripts/libs/LAB.min.js?v={{ v_js_includes|attr_url }}"></script>
<script>
$LAB.setGlobalDefaults({BasePath: "{{ ROOT_URL|attr }}"});
</script>
</head>
<body>
