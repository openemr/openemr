#}
<div id="finder-heading-content" class="d-flex flex-wrap align-items-center">
    <ul class="nav nav-tabs" id="finderTabsNav" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="listTab" data-toggle="tab" data-target="#list" type="button" role="tab" aria-controls="list" aria-selected="true">{{ "Patient List"|xlt }}<span class="badge badge-pill finder-tab-count d-none"></span></button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="recentTab" data-toggle="tab" data-target="#recent" type="button" role="tab" aria-controls="recent" aria-selected="false">{{ "Recent Patients"|xlt }}<span class="badge badge-pill finder-tab-count d-none"></span></button></li>
    </ul>
</div>
