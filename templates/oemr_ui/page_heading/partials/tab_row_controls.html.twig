{#
The right-hand end of the patient tab row, from OemrUI->tabRowControls(). The tab row
names the section, so the visible page title is left out; the title stays for screen readers.

@package OpenEMR
@subpackage OemrUi

@author David Eschelbacher <psoas@tampabay.rr.com>
@copyright Copyright (c) 2026 David Eschelbacher
@license https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
#}
<h1 class="sr-only">{{ heading|text }}</h1>
{% if primaryMenu|length > 0 %}
    {% import "nav/partials/navbar-nav.html.twig" as navbar %}
    {{ navbar.navbar_nav(primaryMenu) }}
{% endif %}
<div class="d-flex align-items-center ml-auto">
    {# Title Nav Content - injected by PageHeadingRenderEvent listeners #}
    {% if titleNavContent|length > 0 %}
        {{ titleNavContent|raw }}
    {% endif %}
    {% include "oemr_ui/page_heading/partials/action_buttons.html.twig" %}
</div>
{% include "oemr_ui/page_heading/partials/action_scripts.html.twig" %}
