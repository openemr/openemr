<nav class="navbar navbar-light navbar-expand-sm bg-light">
    {% block pageHeading %}
        <span class="navbar-brand mb-0 h1">{{ heading|text }}</span>
        {# Title Nav Content - injected by PageHeadingRenderEvent listeners #}
        {% if titleNavContent is defined and titleNavContent|length > 0 %}
            {{ titleNavContent|raw }}
        {% endif %}
    {% endblock %}
    <div class="collapse navbar-collapse">
        {% block primaryButtons %}
            {% import "nav/partials/navbar-nav.html.twig" as navbar %}
            {{ navbar.navbar_nav(primaryMenu) }}
        {% endblock %}
        {% block actionButtons %}
            {% include "oemr_ui/page_heading/partials/action_buttons.html.twig" %}
        {% endblock %}
    </div>
</nav>
{% include "oemr_ui/page_heading/partials/action_scripts.html.twig" %}
