{#
  Read-only preview of one repository questionnaire, opened from the availability screen.
  Rendered by OpenEMR\Controllers\Interface\Super\QuestionnaireImportController.

  @package   OpenEMR
  @link      https://www.open-emr.org
  @author    Jerry Padgett <sjpadgett@gmail.com>
  @copyright Copyright (c) 2026 Jerry Padgett <sjpadgett@gmail.com>
  @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
#}
<!DOCTYPE html>
<html>
<head>
    <title>{{ 'Questionnaire Preview'|xlt }}</title>
    {{ setupHeader([], false) }}
    {% include 'super/_questionnaire_runtime_assets.html.twig' %}
</head>
<body class="body_top">
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
        <h2 class="h4 mb-0">{{ name|text }}</h2>
        <div class="btn-group btn-group-sm">
            <button type="button" id="view-response" class="btn btn-outline-primary">{{ 'View Response'|xlt }}</button>
            <a class="btn btn-secondary" href="manage_questionnaire_availability.php" onclick="top.restoreSession()">{{ 'Back'|xlt }}</a>
        </div>
    </div>
    {% if questionnaireJson == '' %}
        <div class="alert alert-warning">{{ 'That questionnaire is not available.'|xlt }}</div>
    {% else %}
        <div id="form-container"></div>
        <pre id="response" class="d-none border p-2 mt-3 small"></pre>
        <script>
            (function () {
                const runtime = OpenEMRQuestionnaire.mount({
                    questionnaire: JSON.parse({{ questionnaireJson|js_escape }}),
                    container: document.getElementById('form-container'),
                    options: { questionLayout: 'vertical' }
                })
                document.getElementById('view-response').addEventListener('click', () => {
                    const output = document.getElementById('response')
                    output.textContent = JSON.stringify(runtime.getQuestionnaireResponse(), null, 2)
                    output.classList.remove('d-none')
                })
            })()
        </script>
    {% endif %}
</div>
</body>
</html>
