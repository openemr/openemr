<script>

    function menu_entry(object)
    {
        var self=this;
        self.label=ko.observable(object.label);

        self.header=false;
        if('url' in object )
        {
            self.url=ko.observable(object.url);
            self.header=false;
        }
        else
        {
            self.header=true;
        }
        if('target' in object)
        {
            self.target=object.target;
        }
        self.requirement=object.requirement;

        if('icon' in object)
        {
            self.icon=object.icon;
        }
        self.icon=object.icon;

        if('helperText' in object)
        {
            self.helperText=object.helperText;
        }
        self.helperText=object.helperText;

        if(object.requirement===0)
        {
            self.enabled=ko.observable(true);
        } else if(object.requirement===1)
        {
            self.enabled=ko.computed(function()
            {
                return app_view_model.application_data.patient()!==null;
            });
        } else if((object.requirement===2) || (object.requirement===3))
        {
            self.enabled=ko.computed(function()
            {
                return (app_view_model.application_data.patient()!==null
                    && app_view_model.application_data.patient().selectedEncounter()!=null);
            });

        }
        else if(object.requirement===4)
        {
            self.enabled=ko.computed(function()
            {
                return app_view_model.application_data.therapy_group()!==null;
            });
        }
        else if(object.requirement===5)
        {
            self.enabled=ko.computed(function()
            {
                return (app_view_model.application_data.therapy_group()!==null
                    && app_view_model.application_data.therapy_group().selectedEncounter()!=null);
            });
        }
        if(self.header)
        {
            self.children=ko.observableArray();
            for(var childIdx=0;childIdx<object.children.length;childIdx++)
            {
                var childObj=new menu_entry(object.children[childIdx]);
                self.children.push(childObj);
            }
        }
        return this;
    }
    function process_menu_object(object,target)
    {
        var newEntry=new menu_entry(object);
        target.push(newEntry);
    }
    function build_main_menu(objects)
    {
        // Build every entry before replacing the menu, so a bad entry leaves the old menu in place.
        var entries=[];
        for(var menuIdx=0;menuIdx<objects.length;menuIdx++)
        {
            process_menu_object(objects[menuIdx],entries);
        }
        app_view_model.application_data.menu(entries);
    }
    var menu_objects={{ menu_restrictions|json_encode }};
    app_view_model.application_data.menu=ko.observableArray();
    build_main_menu(menu_objects);

    /**
     * Rebuild the main menu from the server without reloading OpenEMR, for a
     * module whose menu entries depend on something the user just changed.
     * Call it from any frame as top.refreshMainMenu(). Resolves to true when
     * the menu was replaced, false when it couldn't be fetched or built (the
     * menu is then left as it was). When refreshes overlap, only the last one
     * started is applied; the earlier ones resolve true without changing the menu.
     */
    var main_menu_refreshes=0;
    window.refreshMainMenu=function()
    {
        var refresh=++main_menu_refreshes;
        restoreSession();
        var request=new FormData();
        request.append("csrf_token_form", csrf_token_js);
        return fetch(webroot_url + "/interface/main/tabs/menu_json.php", {
            method: 'POST',
            credentials: 'same-origin',
            body: request
        }).then(function(response) {
            if (!response.ok) {
                throw new Error("menu_json.php answered " + response.status);
            }
            return response.json();
        }).then(function(objects) {
            if (refresh===main_menu_refreshes) {
                build_main_menu(objects);
            }
            return true;
        }).catch(function(error) {
            console.error("refreshMainMenu: " + error);
            return false;
        });
    };
</script>
