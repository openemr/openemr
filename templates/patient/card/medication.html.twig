{% extends "patient/card/card_base.html.twig" %}

{% block content %}

<div class="{{ list_group_container_class_list|default(['list-group', 'list-group-flush', 'pami-list'])|join(' ') }}">
{% if list|length == 0 %}
    {% if listTouched == true %}
        <div class="list-group-item p-0 pl-1">
            {{ "None{{Issues}}"|xlt }}
        </div>
    {% else %}
    <div class="list-group-item p-0 pl-1">
        {{ "Nothing Recorded"|xlt }}
    </div>
    {% endif %}
{% else %}
    {% for m in list %}
        <div class="list-group-item p-0 pl-1">
            <span class="font-weight-normal">{{ m.title|text }}</span>
            <span>{{ (m.dose|default(m.drug_dosage_instructions))|text }}</span>
        </div>
    {% endfor %}
{% endif %}
{% if inactive is defined and inactive|length > 0 %}
    <div class="list-group-item p-0 pl-1 text-muted small font-italic">{{ "Inactive / historical"|xlt }}</div>
    {% for m in inactive %}
        <div class="list-group-item p-0 pl-1 text-muted">
            <span class="font-weight-normal">{{ m.title|text }}</span>
            <span>{{ (m.dose|default(m.drug_dosage_instructions))|text }}</span>
        </div>
    {% endfor %}
{% endif %}
</div>
{% if printHref is defined and printHref %}
<div class="p-1">
    <a href="{{ printHref|attr }}" target="_blank" onclick="top.restoreSession()">{{ "Print medications"|xlt }}</a>
</div>
{% endif %}
{% endblock %}
