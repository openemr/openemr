{#
  Panes for the administration tabs in admin_tab_nav.html.twig, and the script that runs them.

  Each screen is embedded rather than merged into the page: it has its own forms, CSRF tokens
  and POST handling, and keeping it a separate document means neither page's submit can reach
  the other's handler. A screen loads the first time its tab opens, so ordinary dashboard
  visits pay nothing for it, and shows a loading line over the frame until it arrives. The
  frame fills the window below the tabs (frame_fit.html.twig) and scrolls inside itself.

  @package   OpenEMR
  @link      https://www.open-emr.org
  @author    Jerry Padgett <sjpadgett@gmail.com>
  @copyright Copyright (c) 2026 Jerry Padgett <sjpadgett@gmail.com>
  @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
#}
{% macro pane(id, frameId, title, url) %}
    <div class="tab-pane fade position-relative" id="{{ id|attr }}" role="tabpanel" aria-labelledby="{{ (id ~ '-tab')|attr }}">
        {# Laid over the frame, not above it, so it does not push the frame down while it shows. #}
        <div class="position-absolute text-center text-muted py-5 d-none frame-loading" style="top: 0; left: 0; right: 0;" data-frame="{{ frameId|attr }}" role="status">
            <span class="spinner-border spinner-border-sm mr-1" aria-hidden="true"></span>{{ 'Loading...'|xlt }}
        </div>
        <iframe id="{{ frameId|attr }}" title="{{ title|attr }}" class="w-100 border-0 d-block assessment-tab-frame" style="height: 80vh;" data-fit-window data-src="{{ url|attr }}"></iframe>
    </div>
{% endmacro %}
{% import _self as tabs %}
{% if canUseTemplates %}
    {{ tabs.pane('document-templates', 'document-templates-frame', 'Document Templates'|xl, templatesUrl) }}
{% endif %}
{% if canManageAvailability %}
    {{ tabs.pane('questionnaire-availability', 'questionnaire-availability-frame', 'Questionnaire Availability'|xl, availabilityUrl) }}
{% endif %}
{% if canImport %}
    {{ tabs.pane('questionnaire-import', 'questionnaire-import-frame', 'Import Questionnaires'|xl, importUrl) }}
{% endif %}
{% if canUseTemplates or canManageAvailability or canImport %}
<script>
    (function () {
        const availabilityFrame = document.getElementById('questionnaire-availability-frame')
        const importFrame = document.getElementById('questionnaire-import-frame')
        const availableTab = document.getElementById('available-assessments-tab')
        let changed = false

        // Load an embedded screen the first time its tab is opened, with a loading line until
        // it arrives.
        function loadOnFirstOpen (tab, frame) {
            tab?.addEventListener('click', () => {
                if (frame && !frame.getAttribute('src')) {
                    top.restoreSession()
                    const loader = document.querySelector('.frame-loading[data-frame="' + frame.id + '"]')
                    if (loader) {
                        loader.classList.remove('d-none')
                        frame.addEventListener('load', () => loader.classList.add('d-none'), { once: true })
                    }
                    frame.setAttribute('src', frame.dataset.src)
                }
            })
        }
        loadOnFirstOpen(document.getElementById('questionnaire-availability-tab'), availabilityFrame)
        loadOnFirstOpen(document.getElementById('questionnaire-import-tab'), importFrame)
        loadOnFirstOpen(document.getElementById('document-templates-tab'), document.getElementById('document-templates-frame'))

        // The first load is the screen itself; any later load is the screen coming back from a
        // save, which can change what this patient's dashboard offers.
        let loads = 0
        availabilityFrame?.addEventListener('load', () => {
            loads++
            if (loads > 1) {
                changed = true
            }
        })
        window.addEventListener('message', (event) => {
            if (event.origin !== window.location.origin || event.source !== importFrame?.contentWindow) {
                return
            }
            if (event.data?.questionnaireImported === true) {
                changed = true
                if (availabilityFrame?.getAttribute('src')) {
                    availabilityFrame.contentWindow.location.reload()
                }
            }
        })
        // The Available list was rendered before the change, so refresh it rather than show a
        // list that no longer matches the rules just saved.
        availableTab?.addEventListener('click', () => {
            if (changed) {
                top.restoreSession()
                window.location.reload()
            }
        })
    })()
</script>
{% endif %}
