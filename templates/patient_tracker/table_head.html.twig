{# The Flow Board table's printed title and header: two rows, so Date and Time sit under one
   "Appointment" heading and the four time columns under one "Time" heading, each with a line
   below it. Every other heading spans both rows, at the top. Headings are left-aligned. The order matches the row cells in
   interface/patient_tracker/patient_tracker.php.

   Input: showOrder (see appointment_when.html.twig), showPid, showReason,
   showEncounter, showProvider (more than one provider on the board), showStaff, drugScreen
   (bool each), fromDate and toDate (formatted, for the printed title)

   @package   OpenEMR
   @link      https://www.open-emr.org
   @author    David Eschelbacher <psoas@tampabay.rr.com>
   @copyright Copyright (c) 2026 David Eschelbacher <psoas@tampabay.rr.com>
   @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3 #}
<caption class="flb-print-title">{{ 'Flow Board'|xlt }}: {{ fromDate|text }}{% if toDate != fromDate %} – {{ toDate|text }}{% endif %}</caption>
<thead class="table-primary">
<tr class="small font-weight-bold text-left">
    <td class="dehead text-ovr-dark flb-group" colspan="2">{{ 'Appointment'|xlt }}</td>
    {% if showOrder %}
    <td class="dehead text-ovr-dark" rowspan="2" title="{{ 'Visit List order'|xla }}">{{ 'Order'|xlt }}</td>
    {% endif %}
    {% if showPid %}
    <td class="dehead text-ovr-dark" rowspan="2" name="kiosk_hide">{{ 'PID'|xlt }}</td>
    {% endif %}
    <td class="dehead flb-name text-ovr-dark" rowspan="2">{{ 'Patient'|xlt }}</td>
    {% if showProvider %}
    <td class="dehead flb-name flb-provider text-ovr-dark" rowspan="2">{{ 'Provider'|xlt }}</td>
    {% endif %}
    <td class="dehead text-ovr-dark" rowspan="2" name="kiosk_hide">{{ 'Visit Type'|xlt }}</td>
    <td class="dehead text-ovr-dark" rowspan="2">{{ 'Status'|xlt }}</td>
    <td class="dehead text-ovr-dark" rowspan="2">{{ 'Room'|xlt }}</td>
    {% if showReason %}
    <td class="dehead text-ovr-dark" rowspan="2" name="kiosk_hide">{{ 'Appt Comment'|xlt }}</td>
    {% endif %}
    {% if showEncounter %}
    <td class="dehead text-ovr-dark" rowspan="2" name="kiosk_hide">{{ 'Encounter'|xlt }}</td>
    {% endif %}
    <td class="dehead text-ovr-dark flb-group" colspan="4">{{ 'Time'|xlt }}</td>
    {% if showStaff %}
    <td class="dehead text-ovr-dark" rowspan="2" name="kiosk_hide">{{ 'Updated By'|xlt }}</td>
    {% endif %}
    {% if drugScreen %}
    <td class="dehead text-ovr-dark" rowspan="2" name="kiosk_hide">{{ 'Random Drug Screen'|xlt }}</td>
    <td class="dehead text-ovr-dark" rowspan="2" name="kiosk_hide">{{ 'Drug Screen Completed'|xlt }}</td>
    {% endif %}
</tr>
<tr class="small font-weight-bold text-left">
    <td class="dehead text-ovr-dark">{{ 'Date'|xlt }}</td>
    <td class="dehead text-ovr-dark">{{ 'Time'|xlt }}</td>
    <td class="dehead text-ovr-dark" title="{{ 'When the patient arrived'|xla }}">{{ 'Arrival'|xlt }}</td>
    <td class="dehead text-ovr-dark" title="{{ 'How long the patient has been in the current status'|xla }}">{{ 'In{{Time in current status}}'|xlt }}</td>
    <td class="dehead text-ovr-dark" title="{{ 'When the patient checked out'|xla }}">{{ 'Out{{Check out time}}'|xlt }}</td>
    <td class="dehead text-ovr-dark" title="{{ 'From arrival to check out, or to now'|xla }}">{{ 'Total'|xlt }}</td>
</tr>
</thead>
