{# The Flow Board's filter form. First row: From and To with the Filter button (which reloads
   the board for those dates), then Patient ID and Patient Name. Second row: the visit
   category, status, facility and provider menus, each as wide as its content. The menus and
   the patient boxes narrow the shown rows as they change (refineMe()).

   Input: filters (OpenEMR\Appointment\FlowBoard\FlowBoardFilters), dateRange (bool: the
   ptkr_date_range setting; without it the dates and Filter are hidden), fromDate and toDate
   (formatted), patientName, patientId, kiosk, medex (bool: medex_enable), medexOnline (bool)

   @package   OpenEMR
   @link      https://www.open-emr.org
   @author    David Eschelbacher <psoas@tampabay.rr.com>
   @copyright Copyright (c) 2026 David Eschelbacher <psoas@tampabay.rr.com>
   @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3 #}
<form name="flb" id="flb" method="post">
    <input type="hidden" name="csrf_token_form" value="{{ csrfTokenRaw()|attr }}" />
    <input type="hidden" id="kiosk" name="kiosk" value="{{ kiosk|attr }}" />
    <div class="flb-filters">
        <div class="flb-filter-group{{ dateRange ? '' : ' d-none' }}">
            <label class="mb-0" for="form_from_date">{{ 'From'|xlt }}:</label>
            <input type="text" id="form_from_date" name="form_from_date" class="datepicker form-control form-control-sm w-auto text-center" size="10" value="{{ fromDate|attr }}" />
            <label class="mb-0" for="form_to_date">{{ 'To{{Range}}'|xlt }}:</label>
            <input type="text" id="form_to_date" name="form_to_date" class="datepicker form-control form-control-sm w-auto text-center" size="10" value="{{ toDate|attr }}" />
            <button type="button" id="filter_submit" class="btn btn-primary btn-sm btn-filter">{{ 'Filter'|xlt }}</button>
        </div>
        <div class="flb-filter-group">
            <label class="mb-0" for="form_patient_id">{{ 'Patient ID'|xlt }}:</label>
            <input type="text" id="form_patient_id" name="form_patient_id" class="form-control form-control-sm w-auto" size="{{ filters.patientIdLength|attr }}" value="{{ patientId|attr }}" onkeyup="refineMe();" />
            <label class="mb-0" for="form_patient_name">{{ 'Patient Name'|xlt }}:</label>
            <input type="text" id="form_patient_name" name="form_patient_name" class="form-control form-control-sm w-auto" size="24" value="{{ patientName|attr }}" onkeyup="refineMe();" />
        </div>
        {% if medex %}
        <div class="flb-filter-group ml-auto">
            <b>MedEx:</b>
            <a href="https://medexbank.com/cart/upload/index.php?route=information/campaigns&amp;g=rem" target="_medex">{{ (medexOnline ? 'On-line' : 'Currently off-line')|xlt }}</a>
        </div>
        {% endif %}
    </div>
    <div class="flb-filters mt-2">
        <select id="form_apptcat" name="form_apptcat" class="form-control form-control-sm w-auto" aria-label="{{ 'Visit Categories'|xla }}" onchange="refineMe('apptcat');">
            <option value="">{{ 'Visit Categories'|xlt }}</option>
            {% for option in filters.categories %}
            <option value="{{ option.id|attr }}"{{ option.id == filters.category ? ' selected' : '' }}>{{ option.label|xlt }}</option>
            {% endfor %}
        </select>
        <select id="form_apptstatus" name="form_apptstatus" class="form-control form-control-sm w-auto" aria-label="{{ 'Visit Status'|xla }}" onchange="refineMe();">
            <option value="">{{ 'Visit Status'|xlt }}</option>
            {% for option in filters.statuses %}
            <option value="{{ option.id|attr }}"{{ option.id == filters.status ? ' selected' : '' }}>{{ option.label|xlt }}</option>
            {% endfor %}
        </select>
        <select id="form_facility" name="form_facility" class="form-control form-control-sm w-auto" aria-label="{{ 'All Facilities'|xla }}" onchange="refineMe('facility');"{{ filters.facilities is empty ? ' disabled' : '' }}>
            <option value="">{{ 'All Facilities'|xlt }}</option>
            {% for option in filters.facilities %}
            <option value="{{ option.id|attr }}"{{ option.id == filters.facility ? ' selected' : '' }}>{{ option.label|text }}</option>
            {% endfor %}
        </select>
        <select id="form_provider" name="form_provider" class="form-control form-control-sm w-auto" aria-label="{{ 'All Providers'|xla }}" onchange="refineMe('provider');"{{ filters.providers|length < 2 ? ' disabled' : '' }}>
            <option value="">{{ 'All Providers'|xlt }}</option>
            {% for option in filters.providers %}
            <option value="{{ option.id|attr }}"{{ option.id == filters.provider ? ' selected' : '' }}>{{ option.label|text }}</option>
            {% endfor %}
        </select>
    </div>
    <div id="message" class="warning"></div>
</form>
