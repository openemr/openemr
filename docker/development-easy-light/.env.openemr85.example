# Copy to .env.openemr85 and adjust OPENEMR_DIR / ports for your machine.
# Keep this stack on different ports from any other local OpenEMR compose project.
COMPOSE_PROJECT_NAME=openemr85
OPENEMR_DIR=/absolute/path/to/openemr
HOST_UID=1000
HOST_GID=1000
WT_HTTP_PORT=8400
WT_HTTPS_PORT=9400
WT_MYSQL_PORT=8420
WT_PMA_PORT=8410
