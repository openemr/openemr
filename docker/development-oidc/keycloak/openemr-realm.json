{
  "id": "openemr",
  "realm": "openemr",
  "enabled": true,
  "displayName": "OpenEMR",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "openemr-sso",
      "name": "OpenEMR Staff SSO",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "https://localhost:9400",
      "baseUrl": "/interface/login/login.php",
      "redirectUris": [
        "https://localhost:9400/interface/login/oidc_callback.php",
        "http://localhost:8400/interface/login/oidc_callback.php"
      ],
      "webOrigins": [
        "https://localhost:9400",
        "http://localhost:8400"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:9400/interface/login/login.php##http://localhost:8400/interface/login/login.php"
      }
    }
  ],
  "users": [
    {
