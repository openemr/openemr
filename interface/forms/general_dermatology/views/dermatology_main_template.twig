                            <div class="col-8">
                                <input type="text" class="form-control" id="location_custom" name="location_custom" placeholder="" value="{{ general_dermatology is empty ?  '' : general_dermatology.location_custom }}"/>
                            </div>
                        </div>
                    </div>
                     <hr class="my-4">

                    <div class="mt-3">
