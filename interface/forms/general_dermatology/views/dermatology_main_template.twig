{% extends 'dermatology_body_template.twig' %}
{% block stylesheet %}
    <!-- css stuff should go here -->
    {% include 'css/css_block.twig' %}
    {% include 'css/swiper_block.twig' %}
     {% include 'css/dx_custom.twig' %}
    <style>
        #autocomplete-list {
            display: none; /* Ensures it's hidden on load */
            position: absolute;
            top: calc(100% + 5px);
            left: 0;
            width: 100%;
            max-height: 250px;
            overflow-y: auto;
            background-color: #fff;
            border: 1px solid #ccc;
            padding: 5px;
            margin: 0;
            z-index: 1000;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 4px;
        }

        #autocomplete-list .autocomplete-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 15px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: background-color 0.2s ease-in-out;
        }

        #autocomplete-list .autocomplete-item:hover {
            background-color: #f1f1f1;
        }

    </style>
{%
    endblock %}
{% block javascript %}
<!-- javascript stuff should go here -->
{% include 'js/js_block.js' %}
{% include 'js/jquery.imagemapster.min.js' %}
{% include 'js/image_mapster_block.js' %}
{% include 'js/swiper.min.js' %}
{% include 'js/swiper_block.js' %}
{% include 'modals/script.js' %}

{% endblock %}
{% block content %}
<div class="container-fluid mt-2 ml-auto">
<script>
    // Create an object for your data
    var dataInfo = {{displayValues|json_encode|raw}};

    // Build justified ICD codes from currently loaded treatment plans.
    // This array is used to populate the justify multi-select when adding charges.
    // It is seeded from server-side data; new plans added dynamically should
    // call addJustifiedCode(code) when a dx_s selection changes.
    {% set justifiedCodes = [] %}
    {% for treatment in treatments %}
        {% if treatment.dx_s is not empty %}
            {% set justifiedCodes = justifiedCodes|merge([treatment.dx_s]) %}
        {% endif %}
    {% endfor %}
    var justified = {{ justifiedCodes|json_encode|raw }};

    // Phase 4: location catalog + saved finding locations for map round-trip.
    window.GeneralDermatologyMap = {
        byId: {{ (mapBootstrap.byId|default({}))|json_encode|raw }},
        byLabel: {{ (mapBootstrap.byLabel|default({}))|json_encode|raw }},
        savedFindings: {{ (mapSavedFindings|default([]))|json_encode|raw }}
    };

    function addJustifiedCode(code) {
        if (code && justified.indexOf(code) === -1) {
            justified.push(code);
        }
    }


    $(document).ready(function(){
        var templateSelect = document.getElementById('form_templates');
        if (!templateSelect) {
            return;
        }

        templateSelect.addEventListener('change', function() {
            if (typeof top.restoreSession === 'function') {
                top.restoreSession();
            }

            var selectedValue = this.value;
            if (!selectedValue) {
                return;
            }

            // Prefer server-built URL base so relative paths cannot break by entry point.
            var templateLoadUrlBase = {{ (templateLoadUrlBase|default(''))|json_encode|raw }} || '';
            if (templateLoadUrlBase.indexOf('__TEMPLATE_ID__') !== -1) {
                window.location.href = templateLoadUrlBase.replace('__TEMPLATE_ID__', encodeURIComponent(selectedValue));
            } else {
                var webroot = {{ (webroot|default(''))|json_encode|raw }} || '';
                window.location.href = webroot + '/interface/patient_file/encounter/load_form.php'
                    + '?formname=general_dermatology&id=' + encodeURIComponent(selectedValue);
            }
        });
    });

</script>
    {% set isTemplateMode = templateMode is defined and templateMode %}
    <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
        <div>
            <h2 class="mb-1">{% if isTemplateMode %}{{ "SOAP TEMPLATE EDITOR" | e }}{% else %}{{ "SOAP NOTE" | e }}{% endif %}</h2>
            {% if isTemplateMode %}
                <p class="text-muted mb-0">{{ "Editing a reusable template. Patient chart data is not updated from this screen." | e }}</p>
            {% endif %}
        </div>
        {% if templateManagerUrl is defined and templateManagerUrl %}
            <div class="mt-1">
                <a class="btn btn-outline-primary btn-sm" href="{{ templateManagerUrl|e }}" onclick="if (typeof top.restoreSession === 'function') { top.restoreSession(); }">{{ "Manage Templates" | e }}</a>
            </div>
        {% endif %}
    </div>

    {% if templateFlash is defined and templateFlash.message %}
        <div class="alert alert-{{ templateFlash.type|default('info')|e }}" role="alert">
            {{ templateFlash.message|e }}
        </div>
    {% endif %}

    {% if not isTemplateMode %}
    <div class="form-group">
        <label for="form_templates">{{"Load Existing Template" | e}}</label>
        <select class="form-control" id="form_templates" name="form_templates">
            <option class="dropdown-item" value="">
                {{"Select" | e }}
            </option>
            {% for template in templateFormsData %}
                <option class="dropdown-item" value="{{ template.id }}"{% if loadedTemplateId is defined and loadedTemplateId == template.id %} selected{% endif %}>
                    {{ template.name }}
                </option>
            {% endfor %}
        </select>
        <small class="form-text text-muted">{{ "Only active templates are listed. Use Manage Templates to create, rename, or deactivate templates." | e }}</small>
    </div>
    {% endif %}
    <!-- - Build in here -->
    <!-- - build the subjective starting here -->
    {# Save target must be the encounter patient form id, never a template row id (except template mode). #}
    <form method="post" action="{{ formSaveAction }}" onsubmit="return top.restoreSession()">

     <fieldset class="mt-3" id="soapForm">
        <input type="hidden" name="csrf_token_form" value="{{ csrf }}"/>
         <input type="hidden" name="encounter" value="{{ encounter | e }}" />
         <input type="hidden" name="mode" value="{{ mode | e }}" />
         {% if isTemplateMode %}
         <input type="hidden" name="template_mode" value="1" />
         {% endif %}
         {% if saveFormId %}
         <input type="hidden" name="id" value="{{ saveFormId | e }}"/>
         {% endif %}

        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-l-12 col-xl-12 col-subjective">
                <div class="form-group row">
                    <div class="custom-control custom-checkbox col-3">
                        <input type="hidden" name="patient_type_new" value="0">
                        <input class="custom-control-input" type="checkbox" name="patient_type_new" id="patient_type_new" value="1" {{ general_dermatology is not empty and general_dermatology.patient_type_new == 1 ? 'checked' : '' }}/>
                        <label class="custom-control-label" for="patient_type_new">{{"New Patient" | e}}</label>
                    </div>
                    <div class="custom-control custom-checkbox col-3">
                        <input type="hidden" name="patient_type_established" value="0">
                        <input class="custom-control-input" type="checkbox" name="patient_type_established" id="patient_type_established" value="1" {{ general_dermatology is not empty and general_dermatology.patient_type_established == 1 ? 'checked' : '' }}/>
                        <label class="custom-control-label" for="patient_type_established">{{"Established Patient" | e}}</label>
                    </div>
                </div>
                <div class="form-custom-header mt-1">
                    <h3>{{ "Subjective" | e }}</h3>
                </div>
                <div class="mt-1 px-1">
                    <h5>{{ "HPI" | e }}</h5>
                </div>



                <div class="form-group">
                    <div>
                        <label>{{"The Patient presents for:" | e }}</label><textarea class="form-control" name="subjective_text" id="subjective_text" cols="100" rows="3" value="{{ general_dermatology is empty ?  '' : general_dermatology.subjective_text }}">{{ general_dermatology is empty ?  '' : general_dermatology.subjective_text }}</textarea>
                    </div>
                    <hr class="my-4">
                    <div class="row">
                        <div class="col col-subjective">
                            <div class="custom-control custom-checkbox">
                                <input type="hidden" name="skinlesion" value="0">
                                <input class="custom-control-input" type="checkbox" name="skinlesion" id="skinlesion1" value="1" {{ general_dermatology is not empty and general_dermatology.skinlesion == 1 ? 'checked' : '' }}/>
