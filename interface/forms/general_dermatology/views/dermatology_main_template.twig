                            </div>
                            <div class="custom-control custom-checkbox">
                                <input type="hidden" name="other2" value="0">
                                <input class="custom-control-input" type="checkbox" name="other2" id="other2" value="1" {{ general_dermatology is not empty and general_dermatology.other2 == 1 ? 'checked' : '' }}/>
                                <label class="custom-control-label" for="other2">{{
                                    "Other" | e
                                    }}</label>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4">


                    <div class="mt-3">
                        <h5>{{ "Onset" | e }}</h5>
                        <div class="row btn-group col-12">
                            <div class="col-3">
                                <div class="form-group">
                                    <label for="onset_year">Years</label>
                                    <select class="form-control" id="onset_year" name="onset_year">
                                        <option class="dropdown-item" value="" {{ general_dermatology is not empty and general_dermatology.onset_year == '' ? 'selected' : '' }}>
                                            {{"Select Year" | e }}
                                        </option>
                                        {% for year in years %}
                                            <option class="dropdown-item" value="{{ year }}" {{ general_dermatology is not empty and general_dermatology.onset_year == year ? 'selected' : '' }}>
                                                {{ year }}
                                            </option>
                                        {% endfor %}
                                        <option class="dropdown-item" value=">10" {{ general_dermatology is not empty and general_dermatology.onset_year == '>10' ? 'selected' : '' }}>
                                            >10
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="form-group">
                                    <label for="onset_month">Months</label>
                                    <select class="form-control" id="onset_month" name="onset_month">
                                        <option class="dropdown-item" value="" {{ general_dermatology is not empty and general_dermatology.onset_month == '' ? 'selected' : '' }}>
                                            {{ "Select Month" | e }}
                                        </option>
                                        {% for month in months %}
                                            <option class="dropdown-item" value="{{ month }}" {{ general_dermatology is not empty and general_dermatology.onset_month == month ? 'selected' : '' }}>
                                                {{ month }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="form-group">
                                    <label for="onset_week">Weeks</label>
                                    <select class="form-control" id="onset_week" name="onset_week">
                                        <option class="dropdown-item" value="" {{ general_dermatology is not empty and general_dermatology.onset_week == '' ? 'selected' : '' }}>
                                            {{ "Select Week" | e }}
                                        </option>
                                        {% for week in weeks %}
                                            <option class="dropdown-item" value="{{ week }}" {{ general_dermatology is not empty and general_dermatology.onset_week == week ? 'selected' : '' }}>
