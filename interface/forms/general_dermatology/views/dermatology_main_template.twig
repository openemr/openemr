                                    "Skin lesion(s)" | e
                                    }}</label>
                            </div>
                            <div class="custom-control custom-checkbox">
                                <input type="hidden" name="cosmetic2" value="0">
                                <input class="custom-control-input" type="checkbox" name="cosmetic2" id="cosmetic2" value="1" {{ general_dermatology is not empty and general_dermatology.cosmetic2 == 1 ? 'checked' : '' }}/>
                                <label class="custom-control-label" for="cosmetic2">{{
                                    "Cosmetic" | e
                                    }}</label>
                            </div>
                            <div class="custom-control custom-checkbox">
                                <input type="hidden" name="hairloss2" value="0">
                                <input class="custom-control-input" type="checkbox" name="hairloss2" id="hairloss2" value="1" {{ general_dermatology is not empty and general_dermatology.hairloss2 == 1 ? 'checked' : '' }}/>
                                <label class="custom-control-label" for="hairloss2">{{
                                    "Hair Loss" | e
                                    }}</label>
                            </div>

                        </div>
                        <div class="col col-subjective">
                            <div class="custom-control custom-checkbox">
                                <input type="hidden" name="skincheck2" value="0">
                                <input class="custom-control-input" type="checkbox" name="skincheck2" id="skincheck2" value="1" {{ general_dermatology is not empty and general_dermatology.skincheck2 == 1 ? 'checked' : '' }}/>
                                <label class="custom-control-label" for="skincheck2">{{
                                    "Skin check" | e
                                    }}</label>
                            </div>
                            <div class="custom-control custom-checkbox">
                                <input type="hidden" name="surgical2" value="0">
                                <input class="custom-control-input" type="checkbox" name="surgical2" id="surgical2" value="1" {{ general_dermatology is not empty and general_dermatology.surgical2 == 1 ? 'checked' : '' }}/>
