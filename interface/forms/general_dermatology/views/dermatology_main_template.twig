                                </div>
                                <div class="col custom-control custom-radio">
                                    <input class="custom-control-input" type="radio" name="prior_1" id="prior-unsure1" value="unsure" {{ general_dermatology is not empty and general_dermatology.prior_1 == 'unsure' ? 'checked' : '' }}/>
                                    <label class="custom-control-label label" for="prior-unsure1">{{ "Unsure" | e }}</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-1"><label class="label">{{ "2:" | e }}</label></div>
                            <div class="col-5">
