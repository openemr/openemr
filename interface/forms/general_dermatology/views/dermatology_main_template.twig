    <script>
        function validateSaveAsTemplate() {
            var nameInput = document.getElementById('general_dermatology_form_template_name');
            var name = nameInput ? nameInput.value.trim() : '';
            if (name.length < 3) {
                window.alert('Template name is required (at least 3 characters).');
                if (nameInput) {
                    nameInput.focus();
                }
                return false;
            }
            return true;
        }
    </script>
    <script>
        const searchInput = document.getElementById('code_search');
        const autocompleteList = document.createElement('ul');
        autocompleteList.id = 'autocomplete-list';
        const chargeCodeSearchUrl = {{ ((webroot|default('')) ~ '/interface/forms/general_dermatology/public/api/fetchCodeData.php')|json_encode|raw }};

        if (searchInput) {
        // Ensure the container is relatively positioned
        const inputContainer = searchInput.parentNode;
        inputContainer.style.position = 'relative';
        inputContainer.appendChild(autocompleteList);

        // Function to position the autocomplete list properly
        function positionAutocompleteList() {
            const inputRect = searchInput.getBoundingClientRect();
            autocompleteList.style.top = `${inputRect.height + 5}px`; // Places it right below input
            autocompleteList.style.width = `${inputRect.width}px`; // Matches width of input
        }

        // Function to fetch and update autocomplete suggestions
        async function fetchAutocompleteResults(query) {
            if (!query.trim() || query.trim().length < 2) {
                autocompleteList.innerHTML = '';
                autocompleteList.style.display = 'none';
                return;
            }

            try {
                if (typeof top.restoreSession === 'function') {
                    top.restoreSession();
                }
                const csrfInput = document.querySelector('input[name="csrf_token_form"]');
                const csrfToken = csrfInput ? csrfInput.value : '';
                const response = await fetch(chargeCodeSearchUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({ query: query.trim(), csrf_token_form: csrfToken })
                });

                const searchData = await response.json().catch(function () { return null; });
                if (!response.ok) {
                    const msg = (searchData && (searchData.message || searchData.error)) || ('HTTP ' + response.status);
                    console.error('Charge code search failed:', msg);
                    updateAutocompleteList([], msg);
                    return;
                }
                if (!Array.isArray(searchData)) {
                    updateAutocompleteList([], (searchData && searchData.error) || 'Unexpected response');
                    return;
                }
                updateAutocompleteList(searchData);
                positionAutocompleteList(); // Ensure proper placement
            } catch (error) {
                console.error('Error fetching autocomplete data:', error);
                updateAutocompleteList([], 'Network error searching codes');
            }
        }
        // Ensure autocomplete list is hidden initially
        autocompleteList.style.display = 'none';
        // Function to update the dropdown list
        function updateAutocompleteList(data, emptyMessage) {
            autocompleteList.innerHTML = ''; // Clear previous results

            if (!data || data.length === 0) {
                if (emptyMessage) {
                    const listItem = document.createElement('li');
                    listItem.classList.add('autocomplete-item');
                    listItem.textContent = emptyMessage;
                    listItem.style.cursor = 'default';
                    autocompleteList.appendChild(listItem);
                    autocompleteList.style.display = 'block';
                    positionAutocompleteList();
                    return;
                }
                autocompleteList.style.display = 'none';
                return;
            }

            data.forEach((item) => {
                const listItem = document.createElement('li');
                listItem.classList.add('autocomplete-item');

                const codeDiv = document.createElement('span');
                codeDiv.textContent = item.code;
                codeDiv.style.fontWeight = 'bold';
                codeDiv.style.minWidth = '80px';

                const textDiv = document.createElement('span');
                textDiv.textContent = item.code_text;
                textDiv.style.flexGrow = '1';

                listItem.appendChild(codeDiv);
                listItem.appendChild(textDiv);
                autocompleteList.appendChild(listItem);
            });

            autocompleteList.style.display = 'block'; // Show dropdown
            positionAutocompleteList();
        }

        // Listen for input changes (debounce slightly)
        let chargeSearchTimer = null;
        searchInput.addEventListener('input', (e) => {
            const searchQuery = e.target.value;
            clearTimeout(chargeSearchTimer);
            chargeSearchTimer = setTimeout(function () {
                fetchAutocompleteResults(searchQuery);
            }, 200);
        });
        }

        // Hide autocomplete when clicking outside
        autocompleteList.addEventListener('click', (e) => {
            const clickedItem = e.target.closest('.autocomplete-item');
            if (clickedItem) {
                const codeEl = clickedItem.querySelector('span:first-child');
                const descEl = clickedItem.querySelector('span:last-child');
                if (!codeEl || !descEl || codeEl === descEl) {
                    return; // status/error row, not a code hit
                }
                const code = codeEl.textContent.trim();
                const description = descEl.textContent.trim();
                if (!code) {
                    return;
                }

                // Insert the new row into the charge table
                handleAutocompleteSelect(code, description);
                if (searchInput) {
                    searchInput.value = '';
                }

                // Clear and hide the autocomplete list
                autocompleteList.innerHTML = '';
                autocompleteList.style.display = 'none';
            }
        });

        const chargeTable = document.getElementById('charges_table'); // Get the table element
        let rowIndex = 0; // Keeps track of how many rows are added

        // Function to handle the selection of an autocomplete item
        function handleAutocompleteSelect(code, description) {
            rowIndex++; // Increment row index for unique naming

            // Create a new row
            const newRow = document.createElement('tr');

            // Create the options for the select field
            let justifyOptions = '';
            for (let i = 0; i < justified.length; i++) {
                justifyOptions += `<option value="${justified[i]}">${justified[i]}</option>`;
            }

            // Define the row HTML with unique names for each entry
            newRow.innerHTML = `
        <td style="width: 185px">
            <input type="text" class="form-control" name="claim[${rowIndex}][code]" value="${code}" readonly>
        </td>
        <td>
            <input type="text" class="form-control" name="claim[${rowIndex}][description]" value="${description}" readonly>
        </td>
        <td style="width: 165px">
            <input type="text" class="form-control" name="claim[${rowIndex}][modifier]">
        </td>
        <td>
            <input type="text" class="form-control" name="claim[${rowIndex}][note]">
        </td>
        <td style="width: 400px">
            <select class="form-control selectpicker" name="claim[${rowIndex}][justify][]" multiple>
                <option value="0"></option>
                ${justifyOptions}
            </select>
        </td>
        <td style="width: 50px; text-align: center;">
            <button type="button" class="btn btn-danger btn-sm delete-row">X</button>
        </td>
    `;

            // Append the new row to the charge table
            chargeTable.appendChild(newRow);

            // Initialize Select2 on the new select element
            $(newRow).find('.selectpicker').select2({
                placeholder: "Select DX Codes",
                allowClear: true,
                width: '100%' // Or 'resolve'
            });

            // Add event listener to delete button
            newRow.querySelector('.delete-row').addEventListener('click', function () {
                newRow.remove(); // Removes the row when delete button is clicked
            });
        }
    </script>

