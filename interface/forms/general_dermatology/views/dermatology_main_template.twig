                            </div>
                        </div>
                        <div class="col">
                            <div class="custom-control custom-checkbox">
                                <input type="hidden" name="rash2" value="0">
                                <input class="custom-control-input" type="checkbox" name="rash2" id="rash2" value="1" {{ general_dermatology is not empty and general_dermatology.rash2 == 1 ? 'checked' : '' }}/>
                                <label class="custom-control-label" for="rash2">{{
