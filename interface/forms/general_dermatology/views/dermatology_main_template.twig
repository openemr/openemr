                                </div>
                                <div class="col custom-control custom-radio">
                                    <input class="custom-control-input" type="radio" name="prior_2" id="prior-no2" value="no" {{ general_dermatology is not empty and general_dermatology.prior_2 == 'no' ? 'checked' : '' }}/>
