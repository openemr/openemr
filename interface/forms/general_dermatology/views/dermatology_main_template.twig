                            </div>
                            <div class="row">
                                <div class="col"><label class="label">{{ "Helped?" | e }}</label></div>
                                <div class="col custom-control custom-radio">
                                    <input class="custom-control-input" type="radio" name="prior_2" id="prior-yes2" value="yes" {{ general_dermatology is not empty and general_dermatology.prior_2 == 'yes' ? 'checked' : '' }}/>
