                        <div class="col-4">
                                    <input type="text" class="form-control" id="severity_text" name="severity_text" placeholder="" value="{{ general_dermatology is empty ? '' : general_dermatology.severity_text|default('') }}"/>
                                </div>
                                <div class="col-8">
                                    <div class="row">
                                        <div class="col">/10</div>
                                        <div class="col custom-control custom-checkbox">
                                            <input type="hidden" name="sx_pain" value="0">
                                            <input class="custom-control-input" type="checkbox" name="sx_pain" id="sx_pain" value="1" {{ general_dermatology is not empty and general_dermatology.sx_pain == 1 ? 'checked' : '' }}/>
                                            <label class="custom-control-label label" for="sx_pain">{{ "Pain" | e }}</label>
                                        </div>
                                        <div class="col custom-control custom-checkbox">
                                            <input type="hidden" name="sx_itch" value="0">
                                            <input class="custom-control-input" type="checkbox" name="sx_itch" id="sx_itch" value="1" {{ general_dermatology is not empty and general_dermatology.sx_itch == 1 ? 'checked' : '' }}/>
                                            <label class="custom-control-label label" for="sx_itch">{{ "Itch" | e }}</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="custom-control custom-checkbox mt-3">
                                    <input type="hidden" name="affecting_adls" value="0">
                                    <input type="checkbox" id="affecting_adls" name="affecting_adls" class="custom-control-input" value="1" {{ general_dermatology is not empty and general_dermatology.affecting_adls == 1 ? 'checked' : '' }}/>
                                    <label class="custom-control-label label" for="affecting_adls">{{ "Affecting ADLs" | e }}</label>
                                </div>
                                <div class="custom-control custom-checkbox  mt-1">
                                    <input type="hidden" name="affecting_sleep" value="0">
                                    <input type="checkbox" id="affecting_sleep" name="affecting_sleep" class="custom-control-input" value="1" {{ general_dermatology is not empty and general_dermatology.affecting_sleep == 1 ? 'checked' : '' }}/>
                                    <label class="custom-control-label label" for="affecting_sleep">{{ "Affecting sleep" | e }}</label>
                                </div>
                                <div class="custom-control custom-checkbox mt-1">
                                    <input type="hidden" name="unrelenting" value="0">
                                    <input type="checkbox" id="unrelenting" name="unrelenting" class="custom-control-input" value="1" {{ general_dermatology is not empty and general_dermatology.unrelenting == 1 ? 'checked' : '' }}/>
                                    <label class="custom-control-label label" for="unrelenting">{{ "Unrelenting" | e }}</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="custom-control custom-checkbox">
                            <input type="hidden" name="asymptomatic" value="0">
                            <input type="checkbox" id="asymptomatic" name="asymptomatic" class="custom-control-input" value="1" {{ general_dermatology is not empty and general_dermatology.asymptomatic == 1 ? 'checked' : '' }}/>
                            <label class="custom-control-label" for="asymptomatic">{{ "asymptomatic" | e }}</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="form-custom-header">
                    <h3>{{ "Exam" | e }}</h3>
                </div>
                <div>
                    <button type="button" id="addNewExam" onclick="reviewOfSystems()" class="btn btn-primary">{{ "Review of Systems Check" | e }}</button>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-4">
                            <div>
                                <h5>{{ "Appearance" | e }}</h5>
                                <div class="custom-control custom-checkbox">
