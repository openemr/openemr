                                </div>
                                <div class="col custom-control custom-radio">
                                    <input class="custom-control-input" type="radio" name="prior_1" id="prior-no1" value="no" {{ general_dermatology is not empty and general_dermatology.prior_1 == 'no' ? 'checked' : '' }}/>
