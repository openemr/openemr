                            <div class="col-5">
                                <input type="text" class="form-control" id="prior_tx1" name="prior_tx1" placeholder="" value="{{ general_dermatology is empty ?  '' : general_dermatology.prior_tx1 }}"/>
                            </div>

                            <div class="row">
                                <div class="col"><label class="label">{{ "Helped?" | e }}</label></div>
                                <div class="col custom-control custom-radio">
                                    <input class="custom-control-input" type="radio" name="prior_1" id="prior-yes1" value="yes" {{ general_dermatology is not empty and general_dermatology.prior_1 == 'yes' ? 'checked' : '' }}/>
