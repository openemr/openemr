                                <input class="custom-control-input" type="checkbox" name="acne2" id="acne2" value="1" {{ general_dermatology is not empty and general_dermatology.acne2 == 1 ? 'checked' : '' }}/>
                                <label class="custom-control-label" for="acne2">{{
