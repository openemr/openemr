              <textarea class="col-9 form-control mr-1" {# name="areas_nonlaser" #} id="areas_nonlaser"  style="float:left;" cols="90" rows="4"></textarea>
              <button type="button" id="" class="btn btn-primary model_value" data-toggle="modal" model-value="nonlaser" data-target="#bodymap">
                {{ "BodyMap" | e }}
              </button>
            </div>
          </div>
          <div style="display:none;" class="row col-12 mt-3">
            <div class="col-4 label">{{ "Number of lesions treated" | e }}</div>
