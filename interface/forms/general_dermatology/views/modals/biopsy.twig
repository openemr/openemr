<div class="modal" id="biopsy">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">{{ "Biopsy" | e }}</h4>
                <button type="button" class="close" data-dismiss="modal"> &times; </button>
            </div>
            <div class="modal-body">
                <div class="row">

                    <input type="text" id="biopsy-bio-location-title" hidden />
                    <div class="row col-12 mt-3">
                        <div class="col-4 label">{{ "Biopsy location" | e }}</div>
                        <div class="col-8 areas_treated">
                            <textarea class="col-9 form-control mr-1"  name="biopsy-areas"  id="areas-biopsy"  style="float:left;" cols="90" rows="4"></textarea>
                            <button type="button" id="" class="btn btn-primary model_value" data-toggle="modal" model-value="biopsy" data-target="#bodymap">
                                {{ "BodyMap" | e }}
                            </button>
                        </div>
                    </div>

                    <div style="display:none;" class="row col-12 mt-3">
                        <div class="col-4 label">{{ "Number of lesions treated" | e }}</div>
                        <div class="col-8 areas_treated"><input class="form-control" type="text" id="areas-count-biopsy" /></div>
                    </div>
                    <input type="text" id="hidden" hidden />

                    <input type="text" id="biopsy-Rule-out-title" hidden />
                    <div class="row col-12 mt-3">
                        <div class="col-4 label">{{ "Rule out" | e }}</div>
                        <div class="col-8">
                            <div class="row">
                                <input class="form-control" type="text"  name="biopsy-rule-out"  id="biopsy-Rule-out-free-text" />
                            </div>
                        </div>
                    </div>
                    <input type="text" id="hidden" hidden />


                    <input type="text" id="biopsy-bio-method-title" hidden />
