          <input type="text" id="laser-Notes-title" hidden />
          <div class="row col-12 mt-3">
            <div class="col-4 label">{{ "Notes" | e }}</div>
            <div class="col-8">
              <div class="row">
                <input class="form-control" type="text" {# name="" #} id="laser-Notes-free-text" />
              </div>
            </div>
          </div>
          <input type="text" id="hidden" hidden />

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" onclick="getValuesFromModal('laser')" class="btn btn-secondary" data-dismiss="modal"> {{ "Close" | e }} </button>
      </div>
    </div>
  </div>
</div>